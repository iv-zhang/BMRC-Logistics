rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTION STOPGAP RULES (plan §0.5, packet S1).
//
// The repo's other rules file, `firestore.rules`, is deliberately wide-open
// (`allow read, write: if true`) so the Firestore Local Emulator Suite can run
// seed/integration/property tests with no auth layer — see the warning at the
// top of that file. `firebase.json` used to point production deploys at that
// same open file; a bare `firebase deploy` could ship it straight to the live
// project (see packet S2, which repoints `firebase.json` at THIS file instead
// and adds a separate `firebase.emulator.json` for local/CI emulator use).
//
// This file is the real security boundary for the live `bmrc-logistics`
// project. It intentionally does NOT implement the full per-role capability
// model from plan §2 (`feat/roles-access` packet R4) yet — that is a bigger,
// carefully-tested change. This is a narrow stopgap with one goal: nobody
// signed OUT can read or write anything, and a signed-in member cannot grant
// themselves admin. Every collection below `users` gets a coarse
// "any signed-in user may read/write" rule, matching today's actual app
// behavior (which has no finer-grained checks of its own yet) so no current
// flow breaks. R4 will tighten per-collection access later.
//
// Do not deploy this file by hand — see docs/plans/log/fix-firestore-rules.md
// for the exact `firebase deploy` command once S1-S3 are reviewed (S4).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's own `users/{uid}` doc, or null if it doesn't exist (a
    // brand-new registrant has no doc yet the instant before `register/page.tsx`
    // writes one — `exists()` guards the `get()` below so that moment never
    // throws instead of cleanly evaluating to "not privileged").
    function callerIsPrivileged() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'quartermaster', 'medops'];
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Every current write site (grepped across app/): register/page.tsx (self
    // create, role: 'member'), app-sidebar.tsx (self-heal create if missing,
    // also role: 'member'), roster/page.tsx (admin/QM/medops editing OTHER
    // members' role/canAudit/memberStatus/joinedTerm/isCommitteeMember),
    // onboarding-tour.tsx + audit-helpers.ts/setAuditPermission +
    // certifications.ts/updateMemberCertification (field updates, self or by
    // admin/QM/medops), test-identity.ts/seedTestUsers (admin/QM creating or
    // merge-updating the seeded `__test_*` identity docs — those ids are never
    // the caller's own uid, so they only pass through the privileged branch).
    match /users/{userId} {
      allow read: if isSignedIn();

      // Create: either the caller creating their OWN doc with role locked to
      // 'member' (the only role register/page.tsx and app-sidebar.tsx's
      // self-heal ever write), or a privileged caller creating/seeding ANY
      // user doc (test identities, which are never the caller's own uid).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'member') ||
        callerIsPrivileged()
      );

      // Update: the caller updating their OWN doc may not change `role`
      // (Firestore's `request.resource.data` on a partial `updateDoc`/merge
      // `setDoc` reflects the field AFTER the write, so an update that never
      // touches `role` trivially satisfies this). A privileged caller may
      // update any other user's doc (roster edits, cert verification,
      // canAudit grants, test-identity reseeding).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role) ||
        callerIsPrivileged()
      );

      allow delete: if callerIsPrivileged();
    }

    // ── everything else ─────────────────────────────────────────────────────
    // No collection in the app today enforces its own per-role write checks
    // beyond client-side gating, so the stopgap's floor is "must be signed
    // in" everywhere. R4 (feat/roles-access) replaces this with real
    // per-collection/per-role rules once that branch lands.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
